-- allium: 3
use "./001-orders.allium" as v1

rule PlaceOrderChecked {
    when: Place(order)
    requires: order.status = open
    requires: order.items <= v1/config.max_items
    ensures: order.status = placed
}

surface Checkout {
    facing customer: Customer

    provides:
        Place(order)

    @guarantee OneOrderPerPlacement
        -- Placing an order creates exactly one order, even when the request is retried.
}
